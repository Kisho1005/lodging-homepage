import React, { useState, useEffect } from 'react';
import { motion } from 'framer-motion';
import { Link } from 'react-router-dom';
import './home.css';
import './sections.css';
import './buttons.css';

import logoImage from '../../assets/facilities_image/rogp.png';
import bbqImage from '../../assets/facilities_image/BBQ.jpg';
import songImage from '../../assets/facilities_image/song.jpg';
import dartsImage from '../../assets/facilities_image/darts.jpg';
import woodTexture from '../../assets/facilities_image/wood-texture.jpg';

const Home = () => {
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    const timer = setTimeout(() => {
      setLoading(false);
    }, 2000);

    return () => clearTimeout(timer);
  }, []);

  if (loading) {
    return (
      <div className="loading-screen">
        <motion.img
          src={logoImage}
          alt="ロゴ"
          className="loading-logo"
          initial={{ opacity: 0 }}
          animate={{ opacity: 1 }}
          transition={{ duration: 1 }}
        />
        <div className="loader"></div>
        <p className="loading-text">Welcome</p>
      </div>
    );
  }

  return (
    <div className="home-container">
      <header className="header">
        <motion.div 
          className="logo-container"
          initial={{ opacity: 0, y: -20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.5 }}
        >
          <img src={logoImage} alt="ロゴ" className="logo-image" />
        </motion.div>
      </header>

      <main className="main-content">
        <section className="hero-section">
          <div className="hero-content">
            <motion.h1 
              className="hero-title"
              initial={{ opacity: 0, y: 20 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ duration: 1, delay: 0.5 }}
            >
              みんなの隠れ家
            </motion.h1>
            <motion.p 
