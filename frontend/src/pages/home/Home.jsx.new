              </motion.div>
              <motion.div 
                className="feature-item"
                whileHover={{ y: -10 }}
              >
                <img src={dartsImage} alt="ダーツ" className="feature-image" />
                <h3 className="feature-title">ダーツで楽しむ</h3>
                <p className="feature-description">
                  本格的なダーツ設備で、スリリングな対戦を
