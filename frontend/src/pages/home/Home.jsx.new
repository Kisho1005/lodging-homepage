              </motion.div>
              <motion.div 
                className="feature-item"
                whileHover={{ y: -10 }}
              >
                <img src={songImage} alt="カラオケ" className="feature-image" />
                <h3 className="feature-title">カラオケ完備</h3>
                <p className="feature-description">
                  最新の機器で、思い出に残る歌声を響かせましょう
