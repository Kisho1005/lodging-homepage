            </motion.div>
          </div>
        </section>

        <section className="section concept-section">
          <div className="section-inner">
            <h2 className="section-title">施設のご案内</h2>
            <div className="feature-grid">
              <motion.div 
                className="feature-item"
                whileHover={{ y: -10 }}
              >
                <img src={bbqImage} alt="BBQ設備" className="feature-image" />
                <h3 className="feature-title">バーベキュー設備</h3>
                <p className="feature-description">
                  海を眺めながら、楽しいバーベキューのひとときを
