                </p>
                <Link to="/news" className="news-link">詳しく見る</Link>
              </div>
            </motion.div>
          </div>
        </section>

        <section className="room-status-section">
          <div className="section-inner">
            <h2 className="section-title">空室情報</h2>
            <div className="calendar-wrapper">
              <div className="room-status-header">
                <h3 className="month-title">2025年8月</h3>
                <div className="room-type-selector">
                  <button className="room-type-btn active">全ての部屋</button>
                  <button className="room-type-btn">和室</button>
                  <button className="room-type-btn">洋室</button>
